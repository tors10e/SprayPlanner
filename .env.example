# ==============================================================================
# SPRAYPLANNER ACTIVE SETTINGS SELECTOR
# ==============================================================================
# Active Environment Mode: production, test, development
# (This dictates which settings group below the application will read)
APP_ENV=development

# Active Docker Volume Path (Used by docker-compose.yml)
# Set this to match your active environment's volume path
DB_VOLUME_PATH=./pgdata_dev


# ==============================================================================
# ENVIRONMENT GROUPS
# ==============================================================================

# --- DEVELOPMENT SETTINGS ---
DEV_DB_HOST=db
DEV_DB_PORT=5432
DEV_DB_NAME=sprayplanner_dev
DEV_DB_USER=postgres
DEV_DB_PASSWORD=Black1ce!
DEV_DB_VOLUME_PATH=./pgdata_dev

# --- TEST SETTINGS ---
TEST_DB_HOST=db
TEST_DB_PORT=5432
TEST_DB_NAME=sprayplanner_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=Black1ce!
TEST_DB_VOLUME_PATH=./pgdata_test

# --- PRODUCTION SETTINGS ---
PROD_DB_HOST=db
PROD_DB_PORT=5432
PROD_DB_NAME=sprayplanner
PROD_DB_USER=postgres
PROD_DB_PASSWORD=Black1ce!
PROD_DB_VOLUME_PATH=/mnt/volume-nyc1-1783782660424/postgres_data
