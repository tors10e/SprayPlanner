# Nginx configuration template for SprayPlanner native deployment.
# Copy this file to /etc/nginx/sites-available/sprayplanner on your production/test server,
# update the paths/domains, and link to sites-enabled.

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP;

    # Path to the frontend React built static files
    root /var/www/sprayplanner;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to Gunicorn running locally on port 5001
    location /api {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
